# Environment Variables for Cambridge Mathematics Learning Platform

# Database (Default: local SQLite database for zero-config operation)
DATABASE_URL="file:./dev.db"

# JWT Secret for Authenticated Student & Teacher Sessions
JWT_SECRET="cambridge_maths_super_secure_jwt_secret_change_in_production_2026"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloudflare Deployment Credentials (used by Wrangler CLI & GitHub Actions)
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_API_TOKEN="your-cloudflare-api-token"

# Optional: emergency CMS passkey (12+ chars). Leave unset to disable. In production use: wrangler secret put CMS_MASTER_PASSKEY
# CMS_MASTER_PASSKEY=""
