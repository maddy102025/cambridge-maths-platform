# Environment Variables for Cambridge Mathematics Learning Platform

# Database (Default: local SQLite database for zero-config operation)
# For Supabase / PostgreSQL, provide: postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?schema=public
DATABASE_URL="file:./dev.db"

# JWT Secret for Authenticated Student & Teacher Sessions
JWT_SECRET="cambridge_maths_super_secure_jwt_secret_change_in_production_2026"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: Supabase configuration (if connecting directly to Supabase Auth & Storage)
# NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Email Delivery Configuration (Optional - fallback to secure console logger when unset)
# SMTP_HOST="smtp.mailtrap.io"
# SMTP_PORT="587"
# SMTP_USER="your-smtp-user"
# SMTP_PASS="your-smtp-pass"
# EMAIL_FROM="no-reply@cambridgemaths.edu"
